# API base for fetches. Also used to build absolute URLs for /uploads/... in production.
# Direct :5000 from :5173 is cross-site — set CROSS_SITE_COOKIES=1 on the server (see server/.env.example).
VITE_API_URL=http://localhost:5000/api

# Cloudflare Turnstile site key (public). When unset, no CAPTCHA widget is shown; server must also skip or not enforce.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAADH4-OSr_3j8eYwr

# Hidden admin bootstrap URL (not linked in the app). Token must match server ADMIN_REGISTER_PORTAL_TOKEN.
VITE_ADMIN_REGISTER_PATH=/r/localdevadm768reg

